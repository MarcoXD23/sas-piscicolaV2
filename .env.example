APP_NAME="El SAS Piscícola"
# Listo para producción. En tu equipo de desarrollo usa APP_ENV=local y APP_DEBUG=true.
# Nunca publiques con APP_DEBUG=true: los errores mostrarían SQL, rutas y configuración.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sas_piscicola_v2
DB_USERNAME=
DB_PASSWORD=

# Copias de seguridad (php artisan piscicola:respaldar). Ver docs/DESPLIEGUE.md
# Carpeta FUERA del proyecto, ruta completa (ej. /var/respaldos/sas-piscicola o C:\respaldos). Vacía = sin respaldos.
RESPALDOS_CARPETA=
# Días que se guarda cada copia (vacío = 14)
RESPALDOS_DIAS=
# Hora del respaldo diario (vacío = 02:00)
RESPALDOS_HORA=
# Carpeta de pg_dump y pg_restore si no están en el PATH (en Windows con comillas simples: PG_BIN='C:\Program Files\PostgreSQL\17\bin')
PG_BIN=

# Términos y privacidad: quién presta el servicio y su correo de contacto (vacíos = las páginas avisan que faltan)
LEGAL_ENTIDAD=
LEGAL_CORREO=

# Fotos de especies: tope de espacio por finca en MB, originales + versiones ligeras (vacío = 2048, 2 GB)
FOTOS_TOPE_FINCA_MB=

# Registros hechos sin conexión: horas máximas que pueden tardar en enviarse (vacío = 48)
SIN_CONEXION_HORAS=

# Proxies de confianza (Nginx o Cloudflare delante de la app): IPs o rangos separados por coma. Vacío = ninguno
TRUSTED_PROXIES=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Con HTTPS la cookie de sesión se marca segura sola. Para forzarlo en producción:
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Asistente IA (Claude, Anthropic). Pon aquí tu clave de console.anthropic.com
ANTHROPIC_API_KEY=
# Opcional: otro modelo de Claude (por defecto claude-opus-5-5)
ANTHROPIC_MODEL=

# Proveedor del asistente IA: claude o gemini (vacío = claude)
ASISTENTE_PROVEEDOR=
# Topes diarios de preguntas al asistente (vacío = 100 por persona y 500 por finca)
ASISTENTE_LIMITE_DIARIO_PERSONA=
ASISTENTE_LIMITE_DIARIO_FINCA=
# Gemini (Google). Clave en https://aistudio.google.com
GEMINI_API_KEY=
# Opcional: otro modelo de Gemini (por defecto gemini-3.5-flash-lite)
GEMINI_MODEL=
# Opcional: modelo de Gemini que se prueba una vez si el principal sigue saturado (500 o 503). Vacío = sin respaldo.
# Sugerido: GEMINI_MODEL_RESPALDO=gemini-flash-lite-latest
GEMINI_MODEL_RESPALDO=

# WhatsApp para alertas críticas (todavía sin proveedor: dejar vacío)
WHATSAPP_PROVEEDOR=
WHATSAPP_TOKEN=
WHATSAPP_NUMERO_ID=

# Minutos de vigencia de los tokens de la API (vacío = 30 días)
SANCTUM_TOKEN_MINUTOS=
